---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign docs = site.pages | concat: site.posts -%}
{%- for doc in docs -%}
  {%- if doc.sitemap == false or doc.url contains "404" -%}{%- continue -%}{%- endif -%}
  {%- assign ext = doc.url | split: "." | last -%}
  {%- if ext == "xml" or ext == "txt" or ext == "css" or ext == "json" -%}{%- continue -%}{%- endif -%}
  {%- for lang in site.languages -%}
    {%- if lang == site.default_lang -%}{%- assign prefix = "" -%}{%- else -%}{%- assign prefix = "/" | append: lang -%}{%- endif %}
  <url>
    <loc>{{ site.url }}{{ prefix }}{{ doc.permalink_lang[lang] | default: doc.url }}</loc>
    {%- if doc.date %}
    <lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>
    {%- endif -%}
    {%- for alt in site.languages -%}
      {%- if alt == site.default_lang -%}{%- assign aprefix = "" -%}{%- else -%}{%- assign aprefix = "/" | append: alt -%}{%- endif %}
    <xhtml:link rel="alternate" hreflang="{{ site.data.locales[alt] }}" href="{{ site.url }}{{ aprefix }}{{ doc.permalink_lang[alt] | default: doc.url }}"/>
    {%- endfor %}
  </url>
  {%- endfor -%}
{%- endfor %}
</urlset>
